<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="498.0" prefWidth="706.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="projetos.cadastroSimples.CadastroSimplesController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
   <children>
      <Label text="Cadastro Simples">
         <font>
            <Font size="32.0" />
         </font>
         <padding>
            <Insets bottom="24.0" />
         </padding>
      </Label>
      <HBox alignment="CENTER" prefHeight="73.0" prefWidth="430.0">
         <children>
            <VBox prefHeight="74.0" prefWidth="162.0">
               <children>
                  <Label text="Nome">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="tfNome" />
                  <Separator orientation="VERTICAL" prefHeight="61.0" prefWidth="14.0" />
                  <Label text="Idade">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <TextField fx:id="tfIdade" />
               </children>
            </VBox>
            <Separator prefHeight="2.0" prefWidth="34.0" />
            <VBox alignment="CENTER" prefHeight="74.0" prefWidth="134.0">
               <children>
                  <Label text="Curso">
                     <font>
                        <Font size="14.0" />
                     </font>
                  </Label>
                  <ComboBox fx:id="cbCurso" prefWidth="150.0" promptText="Selecionar Curso" />
               </children>
            </VBox>
         </children>
      </HBox>
      <HBox alignment="CENTER" prefHeight="38.0" prefWidth="644.0">
         <children>
            <Button mnemonicParsing="false" onAction="#onClickCadastrar" text="Cadastrar">
               <HBox.margin>
                  <Insets bottom="8.0" top="8.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <Label fx:id="lbAviso" textFill="#c10909">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TableView fx:id="tbAlunos" prefHeight="200.0" prefWidth="450.0">
        <columns>
          <TableColumn fx:id="tcNome" prefWidth="75.0" text="Nome" />
          <TableColumn fx:id="tcIdade" prefWidth="75.0" text="Idade" />
            <TableColumn fx:id="tcCurso" prefWidth="75.0" text="Curso" />
            <TableColumn fx:id="tcAcao" prefWidth="75.0" text="Ação" />
        </columns>
      </TableView>
   </children>
</VBox>
